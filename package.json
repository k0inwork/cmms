{
  "name": "cmms",
  "version": "0.1.0",
  "description": "Wind Turbine CMMS/FSM/EAM Platform",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:prod": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset",
    "showcase:1": "tsx scripts/showcase/chain1-inspection-to-resolution.ts",
    "showcase:2": "tsx scripts/showcase/chain2-absence-replacement.ts",
    "showcase:3": "tsx scripts/showcase/chain3-sync-conflict.ts",
    "showcase:4": "tsx scripts/showcase/chain4-ticket-reopen.ts",
    "showcase:5": "tsx scripts/showcase/chain5-commissioning.ts",
    "showcase": "tsx scripts/showcase/run-all.ts"
  },
  "dependencies": {
    "@faker-js/faker": "^10.4.0",
    "@hono/node-server": "^2.0.2",
    "@hono/zod-validator": "^0.8.0",
    "@prisma/client": "^6.8.0",
    "bcryptjs": "^2.4.3",
    "hono": "^4.7.0",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^25.6.0",
    "prisma": "^6.8.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
